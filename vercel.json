{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/**"
    }
  },
  "redirects": [
    {
      "source": "/dear-nadine",
      "destination": "/newsletter",
      "permanent": true
    },
    {
      "source": "/dear-nadine/:path*",
      "destination": "/newsletter",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
